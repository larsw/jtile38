<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jtile38</groupId>
    <artifactId>jtile38-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>jtile38-server</artifactId>
  <name>jtile38-server</name>
  <description>Tile38-compatible geospatial server (port of github.com/tidwall/tile38 internal/server)</description>

  <properties>
    <main.class>io.jtile38.server.MainKt</main.class>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.jtile38</groupId>
      <artifactId>jtile38-json</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jtile38</groupId>
      <artifactId>jtile38-geojson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jtile38</groupId>
      <artifactId>jtile38-rtree</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jtile38</groupId>
      <artifactId>jtile38-resp</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jtile38</groupId>
      <artifactId>jtile38-expr</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jtile38</groupId>
      <artifactId>jtile38-a5</artifactId>
    </dependency>
    <dependency>
      <groupId>redis.clients</groupId>
      <artifactId>jedis</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>jtile38-server</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${main.class}</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>${main.class}</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
